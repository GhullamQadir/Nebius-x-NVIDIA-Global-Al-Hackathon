# Nexora Environment Configuration
# Copy this file to .env or nexora/.env and fill in your keys

# Application
APP_NAME=Nexora
APP_VERSION=3.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8001

# Database (Default: Embedded SQLite, zero installation needed)
DATABASE_URL=sqlite+aiosqlite:///./nexora.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Nebius Token Factory / NVIDIA Nemotron API Key
# Get your API key from https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TIMEOUT=120

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001

# Default Budget Profile (demo, standard, strict)
DEFAULT_BUDGET_PROFILE=demo

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend URL
FRONTEND_URL=http://localhost:3000
