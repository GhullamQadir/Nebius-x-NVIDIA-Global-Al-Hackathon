# Nexora Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Nexora
APP_VERSION=3.0.0
# Set DEBUG=true only for local development. Never deploy with DEBUG=true.
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8001

# Database
DATABASE_URL=sqlite+aiosqlite:///./nexora.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001

# Nebius / NVIDIA Provider
NEBIUS_API_KEY=replace-with-a-rotated-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TIMEOUT=120

# Token Factory Sandbox
SANDBOX_API_URL=https://sandbox.api.nvidia.com/v1
SANDBOX_API_KEY=your-sandbox-api-key
SANDBOX_TIMEOUT=300

# Budget Profiles
DEFAULT_BUDGET_PROFILE=demo

# Worker
WORKER_POOL_SIZE=2
WORKER_LEASE_TTL=300
WORKER_POLL_INTERVAL=1.0

# Audit
AUDIT_HASH_ALGORITHM=sha256

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
FRONTEND_URL=http://localhost:3000